  "cards": [
    {
      "dot": "amber",
      "title": "问题：人人对接的四环节丢失",
      "items": [
        "提供方的人整理文档（① 筛选省略）→ 接收方的人读文档（② 理解偏差）→ 按自己习惯重梳理（③ 二次转写变形）→ 按梳理结果执行（④ 持续偏离）",
        "每一环都是「人做有损压缩」，越靠近下游失真越大——文档看着齐了，关键细节早已丢失"
      ]
    },
    {
      "dot": "cyan",
      "title": "方案：relay 对接桌（AI 端到端）",
      "items": [
        "整理、理解、梳理全部由双方 AI 承载：对接单是面向 AI 消费的结构（三层 + 负面清单 + 未决 + 转递声明），版本化、可定位",
        "接收方 AI 按下一步任务定制「所需内容清单」，对照清单核验、缺口定向索要——信息传递最大化；下一步工作直接消费对接单，不「人读→重写」"
      ]
    },
    {
      "dot": "rose",
      "title": "人在环：只在两端把控",
      "items": [
        "人不在信息通道里做转写：提供方持有人只定三层授权规则（开始后锁定），接收方持有人过目索要清单",
        "超出规则的数据必须提供方持有人亲自审批（DATA_GRANT 为网页专属，agent 无法自批）；全程留痕，闭桌自动生成对接纪要"
      ]
    }
  ]
