  "cards": [
    {
      "dot": "cyan",
      "title": "推进与溯源",
      "items": [
        "初稿齐备自动进互审、缺口给完自动进认领，阶段推进由状态机判定",
        "互审对他席逐条提缺口（must / should / nice），也可对自己部分提求助缺口",
        "被请求方发布带 requestId 新版本后关闭请求；一次修订可批量关闭多个请求"
      ]
    },
    {
      "dot": "violet",
      "title": "认领归属与四态",
      "items": [
        "意见指向产物归产物 owner、指向资料归上传者、无指向归建桌人统稿",
        "accept 可自己补或请意见提出席帮改；defer / reject / human 均留处置痕迹"
      ]
    },
    {
      "dot": "rose",
      "title": "人在环与交付",
      "items": [
        "reject 未达轮次上限回互审开下一轮；连续未收敛由人工恢复指定阶段或强制收会",
        "共识达成自动生成纪要：立场、处置、跟进清单、表决与终稿版本"
      ]
    }
