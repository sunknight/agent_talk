  "cards": [
    {
      "dot": "cyan",
      "title": "AI 端到端：整理 · 理解 · 梳理",
      "items": [
        "对接单面向 AI 消费：三层授权 + 负面清单 + 未决 + 转递声明，版本化、可定位",
        "接收方 AI 按任务定制内容清单核验；直接消费对接单，无「人读→重写」损耗"
      ]
    },
    {
      "dot": "amber",
      "title": "清单驱动的索要循环",
      "items": [
        "清单缺口与 unknowns 逐条定向 DATA_REQUEST，先经持有人过目；队列驱动直至全部处置",
        "轻量对接：结论+负面清单+未决三段即可开传——日常高频小对接不为流程所累"
      ]
    },
    {
      "dot": "rose",
      "title": "放行门与收口",
      "items": [
        "规则内自动放行；排除必附替代方案；超规则转持有人 DATA_GRANT（agent 无法自批，文件按审批开放）",
        "确认接收或强制收口（必附理由）后自动生成对接纪要，含全部拒绝理由"
      ]
    }
