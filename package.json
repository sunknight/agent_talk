{
  "name": "agent-talk",
  "private": true,
  "version": "0.9.3",
  "description": "Agent 圆桌会谈系统 — 多人各带自己的 agent 入桌协作/博弈，安全审批闭环",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "server": "npm run -w @rt/server start",
    "server:dev": "tsx packages/server/src/index.ts",
    "deploy": "bash scripts/deploy.sh"
  },
  "devDependencies": {
    "@types/node": "^24.13.6",
    "tsx": "^4.19.0",
    "typescript": "^5.5.4",
    "vitest": "^3.2.7"
  }
}
